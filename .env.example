NODE_ENV=development
APP_PORT=3000
CORS_ORIGIN=http://localhost:5173
WEB_RESET_PASSWORD_URL=http://localhost:5173/reset-password
WEB_ACCEPT_INVITE_URL=http://localhost:5173/accept-invite
WEB_VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# Dev DB: docker compose service "postgres" (5432). Must stay a literal URL (Prisma CLI).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Test DB: docker compose service "postgres_test" (5433). Read only by test/support/test-app.ts.
DB_TEST_HOST=localhost
DB_TEST_PORT=5433
DB_TEST_USER=app
DB_TEST_PASSWORD=app
DB_TEST_NAME=app_test

# REDIS_URL is derived from these (src/common/config/env.schema.ts). Used for throttler storage.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOGIN_THROTTLE_LIMIT=10
WEBHOOK_THROTTLE_LIMIT=300
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
FIREBASE_SERVICE_ACCOUNT_PATH=

JWT_ACCESS_SECRET=change-me-32-bytes-minimum-secret-value
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper

SUPER_ADMIN_EMAIL=admin@app.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Mailpit in dev: UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@app.local

# MinIO console http://localhost:9001. Empty keys disable storage.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=app
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_URL=

# Empty server key disables the payment gateway.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
